# Copy to .env for local development. The app reads only real environment
# variables, so export them first, e.g.: set -a && . ./.env && set +a
# Values below are local-only placeholders, never real credentials.

# local | test | staging | production
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://dtm:dtm@localhost:5432/dtm
REDIS_URL=redis://localhost:6379/0

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console (console is for humans, locally)
LOG_FORMAT=console

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000
SLOW_QUERY_MS=100
READINESS_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
# Per-process Redis pool (1..200). When all are busy a caller waits at most
# REDIS_SOCKET_TIMEOUT_SECONDS for a free connection.
REDIS_MAX_CONNECTIONS=20
