# Copy to .env (`make up` does it when .env is missing). Values below are local-only
# placeholders, never real credentials.
#
# docker compose reads this file. Tools run on the host (make migrate, uvicorn) read
# only real environment variables, so export it first: set -a && . ./.env && set +a

# local | test | staging | production
APP_ENV=local

# Local compose database and cache (compose.yaml). The URLs below reach them through
# the ports compose publishes on 127.0.0.1; inside compose the app uses service names.
# compose.yaml inserts POSTGRES_USER and POSTGRES_PASSWORD into the containers'
# DATABASE_URL unescaped: use only letters, digits and - _ . ~ in them (@ : / # ? %
# break the URL, which is then reported as "host is missing").
POSTGRES_USER=dtm
POSTGRES_PASSWORD=dtm
POSTGRES_DB=dtm
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
API_HOST_PORT=8000
DATABASE_URL=postgresql+asyncpg://dtm:dtm@localhost:55432/dtm
REDIS_URL=redis://localhost:56379/0

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console (console is for humans, locally; compose containers always use json)
LOG_FORMAT=console

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000
SLOW_QUERY_MS=100
READINESS_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
# Per-process Redis pool (1..200). When all are busy a caller waits at most
# REDIS_SOCKET_TIMEOUT_SECONDS for a free connection.
REDIS_MAX_CONNECTIONS=20
