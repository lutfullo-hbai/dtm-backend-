{
  "components": {
    "schemas": {
      "HealthResponse": {
        "description": "Liveness result: the process is up and serving requests.",
        "properties": {
          "status": {
            "const": "ok",
            "description": "Always `ok` when the process responds.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "NotReadyProblem": {
        "description": "Problem body returned when at least one dependency is unavailable.",
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks",
            "description": "Per-dependency results."
          },
          "code": {
            "description": "Stable, machine-readable snake_case error key.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "description": "Human-readable explanation of this occurrence.",
            "title": "Detail",
            "type": "string"
          },
          "request_id": {
            "description": "Correlation id, also sent as X-Request-ID.",
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code.",
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short, human-readable summary of the problem type.",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "URI reference identifying the problem type.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "request_id",
          "checks"
        ],
        "title": "NotReadyProblem",
        "type": "object"
      },
      "ProblemDetails": {
        "description": "RFC 9457 problem body shared by every error response.",
        "properties": {
          "code": {
            "description": "Stable, machine-readable snake_case error key.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "description": "Human-readable explanation of this occurrence.",
            "title": "Detail",
            "type": "string"
          },
          "request_id": {
            "description": "Correlation id, also sent as X-Request-ID.",
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code.",
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short, human-readable summary of the problem type.",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "URI reference identifying the problem type.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "request_id"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ReadinessChecks": {
        "description": "Per-dependency readiness results.",
        "properties": {
          "database": {
            "description": "PostgreSQL `SELECT 1` result.",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "redis": {
            "description": "Redis `PING` result.",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Redis",
            "type": "string"
          }
        },
        "required": [
          "database",
          "redis"
        ],
        "title": "ReadinessChecks",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Readiness result when every dependency is reachable.",
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "const": "ok",
            "description": "`ok` when all dependencies are reachable.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ValidationErrorItem": {
        "description": "One invalid input. The rejected value itself is never echoed back.",
        "properties": {
          "loc": {
            "description": "Path to the input, e.g. [\"query\", \"limit\"].",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "message": {
            "description": "Human-readable reason.",
            "title": "Message",
            "type": "string"
          },
          "type": {
            "description": "Stable machine-readable error type, e.g. `int_parsing`.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "message",
          "type"
        ],
        "title": "ValidationErrorItem",
        "type": "object"
      },
      "ValidationProblem": {
        "description": "Problem body for 422 `validation_error`.",
        "properties": {
          "code": {
            "description": "Stable, machine-readable snake_case error key.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "description": "Human-readable explanation of this occurrence.",
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "description": "Every invalid input.",
            "items": {
              "$ref": "#/components/schemas/ValidationErrorItem"
            },
            "title": "Errors",
            "type": "array"
          },
          "request_id": {
            "description": "Correlation id, also sent as X-Request-ID.",
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code.",
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short, human-readable summary of the problem type.",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "URI reference identifying the problem type.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "request_id",
          "errors"
        ],
        "title": "ValidationProblem",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DTM Tutor API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Reports that the process is running. Never touches PostgreSQL or Redis.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "status": "ok"
                },
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "internal_error",
                  "detail": "An unexpected error occurred. Quote the request id when reporting it.",
                  "request_id": "0190f3c2-7b1e-7c4a-9d2f-3a1b2c3d4e5f",
                  "status": 500,
                  "title": "Internal Server Error",
                  "type": "/problems/internal-error"
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected server error; the cause is only logged."
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Checks PostgreSQL (`SELECT 1`) and Redis (`PING`) concurrently, each bounded by READINESS_TIMEOUT_SECONDS. Returns 503 if either is unavailable.",
        "operationId": "get_ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "checks": {
                    "database": "ok",
                    "redis": "ok"
                  },
                  "status": "ok"
                },
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "internal_error",
                  "detail": "An unexpected error occurred. Quote the request id when reporting it.",
                  "request_id": "0190f3c2-7b1e-7c4a-9d2f-3a1b2c3d4e5f",
                  "status": 500,
                  "title": "Internal Server Error",
                  "type": "/problems/internal-error"
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected server error; the cause is only logged."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "example": {
                  "checks": {
                    "database": "ok",
                    "redis": "unavailable"
                  },
                  "code": "not_ready",
                  "detail": "One or more dependencies are unavailable.",
                  "request_id": "0190f3c2-7b1e-7c4a-9d2f-3a1b2c3d4e5f",
                  "status": 503,
                  "title": "Service not ready",
                  "type": "/problems/not-ready"
                },
                "schema": {
                  "$ref": "#/components/schemas/NotReadyProblem"
                }
              }
            },
            "description": "A dependency is unavailable."
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  }
}
